# Copy this to .env only if .env does not already exist.
# Only OPENAI_API_KEY is required. Never commit an actual key.
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
OPENAI_PROJECT_ID=""
OPENAI_MODEL="gpt-6.1-sol"
OPENAI_REASONING_EFFORT="low"
ALLOW_PAID_API_CALLS="false"
SWARM_AGENTS="8"
SWARM_DISCUSSION_ROUNDS="3"
SWARM_MAX_MESSAGE_CHARS="600"
SWARM_PILOT_SEEDS="5"
SWARM_MAIN_SEEDS="40"
SWARM_MAX_CONCURRENT_EPISODES="2"
OPENAI_TIMEOUT_SECONDS="90"
OPENAI_MAX_OUTPUT_TOKENS="2048"
SWARM_PILOT_BUDGET_USD="5.00"
SWARM_TOTAL_BUDGET_USD="50.00"
OPENAI_INPUT_USD_PER_MILLION="2.00"
OPENAI_CACHED_INPUT_USD_PER_MILLION="0.10"
OPENAI_OUTPUT_USD_PER_MILLION="10.00"
SWARM_RUNS_DIR="runs"
