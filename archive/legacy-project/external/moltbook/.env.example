# Copy to .env and fill in. Never commit .env.
# Only the providers you actually run are required:
#   openai    -> Exp 1-8 (GPT-5-mini, o4-mini)
#   anthropic -> cross-model + heterogeneous Config A (Claude 4.5 Haiku)
#   google    -> cross-model + heterogeneous Config B (Gemini 3.1 Flash-Lite)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
